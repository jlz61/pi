{
	"name": "personal-agent-harness",
	"version": "0.1.0",
	"private": true,
	"description": "Observable and evaluable agent harness built on pi",
	"type": "module",
	"bin": {
		"harness": "./dist/cli.js"
	},
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./node": {
			"types": "./dist/node/index.d.ts",
			"import": "./dist/node/index.js"
		}
	},
	"files": [
		"dist",
		"python",
		"README.md"
	],
	"scripts": {
		"build": "tsc -p tsconfig.build.json",
		"check": "tsc --noEmit",
		"test": "vitest --run",
		"test:python": ".venv-swebench/bin/python -m unittest python/test_swebench_bridge.py",
		"demo": "vitest --run test/demo.test.ts"
	},
	"dependencies": {
		"@earendil-works/pi-agent-core": "0.83.0",
		"@earendil-works/pi-ai": "0.83.0",
		"@earendil-works/pi-storage-sqlite-node": "0.83.0",
		"typebox": "1.3.7",
		"undici": "8.9.0"
	},
	"devDependencies": {
		"@types/node": "24.12.4",
		"typescript": "5.9.3",
		"vitest": "4.1.9"
	},
	"engines": {
		"node": ">=22.19.0"
	}
}
